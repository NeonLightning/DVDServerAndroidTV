<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="48dp">

    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Visual Settings -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPEARANCE"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:tag="label_appearance" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UI Theme"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:tag="label_ui_theme" />

            <Button
                android:id="@+id/themeButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tv_card"
                android:text="Android TV"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CACHE MANAGEMENT"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:tag="label_cache_mgmt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Automatic Clearing"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:tag="label_auto_clearing" />

            <Button
                android:id="@+id/cacheModeButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tv_card"
                android:text="Manual Only"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCREENSAVER &amp; DIMMING"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:tag="label_screensaver" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inactivity Timeout"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:tag="label_timeout" />

            <Button
                android:id="@+id/screensaverTimeButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tv_card"
                android:text="2 Minutes"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:focusable="true" />
        </LinearLayout>

        <!-- Server Settings -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVER CONNECTION"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:tag="label_server_conn" />

            <TextView
                android:id="@+id/currentServerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current: http://..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/serverSetupButton"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/accent"
                android:text="CONFIGURE SERVER"
                android:textStyle="bold"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Changes will apply when you return to the main screen."
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:tag="label_changes_hint" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
