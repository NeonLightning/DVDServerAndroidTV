<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DVDServer" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#E91E63</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#101014</item>
    </style>

    <style name="Theme.DVDServer.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">#1B1B22</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B9B9C2</item>
        <item name="colorAccent">#E91E63</item>
    </style>

    <style name="Theme.DVDServer.Dialog.Light" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#555555</item>
        <item name="colorAccent">#2563EB</item>
    </style>

    <style name="Theme.DVDServer.Dialog.HotDog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">#FFFF00</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="colorAccent">#FF0000</item>
    </style>
</resources>
